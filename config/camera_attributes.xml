<?xml version="1.0" encoding="UTF-8"?>
<!--
  Camera attribute dictionary.
  Maps alias names (as written in CameraConfig::capabilities) to the GStreamer
  element property name used by the source element (nvarguscamerasrc / v4l2src).

  Attributes:
    gstProperty  — the source element's property name; for v4l2_control, the
                   V4L2 control's name instead (see below).
    type         — "CSI" | "USB" | "any".
    valueType    — how the value string is parsed:
                     string        the string as is
                     int           an integer
                     float         a float
                     bool          "true"/"false" or "1"/"0"
                     bool_from_zero  int; 0→TRUE, non-zero→FALSE (AE/AWB lock inversion)
                     range_string  mirror single value to "val val" (nvargus range props)
                     v4l2_control  an integer V4L2 control, written through v4l2src's
                                   extra-controls; gstProperty is the control's name as
                                   v4l2-ctl lists it (lower case, "_" for separators).
                                   start() sends the controls queued before it in one
                                   write, auto controls (auto_exposure,
                                   white_balance_automatic, ...) before the manual values
                                   they gate.  A write while running carries only its own
                                   control, so the order is then the caller's: set the auto
                                   control first, in a write of its own (auto_exposure=1,
                                   manual mode, before exposure_time_absolute;
                                   white_balance_automatic=0 before
                                   white_balance_temperature).
                   A property value is converted to the property's own type and
                   range-checked; one that does not fit is refused with a WARN.
                   A v4l2_control value is checked for being an integer only: v4l2src
                   gives no feedback.  The driver clamps a value outside the control's
                   range, and v4l2src drops a control the camera lacks, a bad menu
                   value, or one the driver refuses (a manual value while its auto
                   control is on) with only a GStreamer warning.  setCameraAttribute()
                   reports NONE in all these cases: check the range and the result
                   with v4l2-ctl -d /dev/videoN (list-ctrls, get-ctrl).

  Alias matching is case-insensitive.  Add new entries here; no recompile needed.
  camera_gst_test checks every entry against the real element (v4l2src; also
  nvarguscamerasrc where it is installed).
-->
<CameraAttributeDictionary>

  <!-- ── CSI (nvarguscamerasrc) ──────────────────────────────────────────────── -->

  <!-- Exposure time in nanoseconds; single value is mirrored to "min max" range -->
  <Attribute gstProperty="exposuretimerange" type="CSI" valueType="range_string">
    <Alias>exposure time, absolute</Alias>
    <Alias>exposure</Alias>
    <Alias>exposuretimerange</Alias>
    <Alias>exposure_time_range</Alias>
  </Attribute>

  <!-- Analogue gain; single value is mirrored to "min max" range -->
  <Attribute gstProperty="gainrange" type="CSI" valueType="range_string">
    <Alias>gain</Alias>
    <Alias>gainrange</Alias>
    <Alias>gain_range</Alias>
  </Attribute>

  <!-- AE lock, as "auto exposure" on/off: 0 → AE locked (aelock=TRUE), non-zero → AE running (aelock=FALSE) -->
  <Attribute gstProperty="aelock" type="CSI" valueType="bool_from_zero">
    <Alias>auto exposure</Alias>
    <Alias>aelock</Alias>
    <Alias>ae_lock</Alias>
  </Attribute>

  <!-- AWB lock, as "white balance, automatic" on/off: 0 → AWB locked (awblock=TRUE), non-zero → AWB running -->
  <Attribute gstProperty="awblock" type="CSI" valueType="bool_from_zero">
    <Alias>white balance, automatic</Alias>
    <Alias>awblock</Alias>
    <Alias>awb_lock</Alias>
  </Attribute>

  <!-- White-balance mode (0=off 1=auto 2=incandescent 3=fluorescent … see Argus docs) -->
  <Attribute gstProperty="wbmode" type="CSI" valueType="int">
    <Alias>wbmode</Alias>
    <Alias>wb_mode</Alias>
    <Alias>white_balance_mode</Alias>
  </Attribute>

  <!-- Colour saturation scalar (0.0 – 2.0; 1.0 = neutral) -->
  <Attribute gstProperty="saturation" type="CSI" valueType="float">
    <Alias>saturation</Alias>
    <Alias>colorsaturation</Alias>
    <Alias>color_saturation</Alias>
  </Attribute>

  <!-- Temporal noise reduction mode (0=off 1=fast 2=high-quality) -->
  <Attribute gstProperty="tnr-mode" type="CSI" valueType="int">
    <Alias>tnr-mode</Alias>
    <Alias>tnr_mode</Alias>
    <Alias>noise_reduction_mode</Alias>
  </Attribute>

  <!-- Temporal noise reduction strength (-1=auto  0.0–1.0=manual) -->
  <Attribute gstProperty="tnr-strength" type="CSI" valueType="float">
    <Alias>tnr-strength</Alias>
    <Alias>tnr_strength</Alias>
    <Alias>noise_reduction_strength</Alias>
  </Attribute>

  <!-- Edge-enhancement mode (0=off 1=fast 2=high-quality) -->
  <Attribute gstProperty="ee-mode" type="CSI" valueType="int">
    <Alias>ee-mode</Alias>
    <Alias>ee_mode</Alias>
    <Alias>edge_enhancement_mode</Alias>
  </Attribute>

  <!-- Edge-enhancement strength (-1=auto  0.0–1.0=manual) -->
  <Attribute gstProperty="ee-strength" type="CSI" valueType="float">
    <Alias>ee-strength</Alias>
    <Alias>ee_strength</Alias>
    <Alias>edge_enhancement_strength</Alias>
  </Attribute>

  <!-- ── USB (v4l2src: V4L2 controls through extra-controls) ─────────────────── -->

  <!-- v4l2src also has brightness / contrast / saturation / hue properties, but
       it applies those only while the device is open and stores nothing
       otherwise, so a value set before start() was dropped.  extra-controls is
       kept and applied when the device opens. -->
  <Attribute gstProperty="brightness" type="USB" valueType="v4l2_control">
    <Alias>brightness</Alias>
  </Attribute>

  <Attribute gstProperty="contrast" type="USB" valueType="v4l2_control">
    <Alias>contrast</Alias>
  </Attribute>

  <Attribute gstProperty="saturation" type="USB" valueType="v4l2_control">
    <Alias>saturation</Alias>
  </Attribute>

  <Attribute gstProperty="hue" type="USB" valueType="v4l2_control">
    <Alias>hue</Alias>
  </Attribute>

  <!-- Controls v4l2src has no property for (named here as properties until
       2026-09-28, which v4l2src ignored with a GLib warning). -->
  <Attribute gstProperty="sharpness" type="USB" valueType="v4l2_control">
    <Alias>sharpness</Alias>
  </Attribute>

  <Attribute gstProperty="gamma" type="USB" valueType="v4l2_control">
    <Alias>gamma</Alias>
  </Attribute>

  <Attribute gstProperty="gain" type="USB" valueType="v4l2_control">
    <Alias>gain</Alias>
  </Attribute>

  <!-- 0 = manual white balance; white_balance_temperature applies only then
       (uvcvideo refuses it while this is 1, the UGREEN's default). -->
  <Attribute gstProperty="white_balance_automatic" type="USB" valueType="v4l2_control">
    <Alias>white_balance_automatic</Alias>
    <Alias>white balance, automatic</Alias>
    <Alias>white_balance_temperature_auto</Alias>
    <Alias>auto_white_balance</Alias>
  </Attribute>

  <!-- Kelvin; needs white_balance_automatic=0 (above). -->
  <Attribute gstProperty="white_balance_temperature" type="USB" valueType="v4l2_control">
    <Alias>white_balance_temperature</Alias>
    <Alias>white balance temperature</Alias>
    <Alias>white-balance-temperature</Alias>
  </Attribute>

  <Attribute gstProperty="backlight_compensation" type="USB" valueType="v4l2_control">
    <Alias>backlight_compensation</Alias>
    <Alias>backlight compensation</Alias>
    <Alias>backlight-compensation</Alias>
  </Attribute>

  <!-- Takes effect only with auto_exposure=1 (manual); 100 µs units. -->
  <Attribute gstProperty="exposure_time_absolute" type="USB" valueType="v4l2_control">
    <Alias>exposure</Alias>
    <Alias>exposure_absolute</Alias>
    <Alias>exposure absolute</Alias>
    <Alias>exposure_time_absolute</Alias>
  </Attribute>

  <!-- 1 = manual, 3 = aperture priority (the camera's own auto-exposure). -->
  <Attribute gstProperty="auto_exposure" type="USB" valueType="v4l2_control">
    <Alias>auto_exposure</Alias>
    <Alias>exposure_auto</Alias>
  </Attribute>

</CameraAttributeDictionary>
