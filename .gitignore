bin/build*
logs/*
archive/*
# Recorded videos land in the archive dir (/user/dashcam == repo root under the dev
# mount), so keep stray recordings out of git.
*.mkv
models/*
docs/*
testlogs/*

# Host test binaries. The sources are the deliverable; these are rebuilt by
# the tests/host Makefiles (or mkr_zero's RunTests.cmd) on every run.
peripherals/*/tests/host/*.exe
peripherals/*/tests/host/*.obj
peripherals/*/tests/host/switch_tests
peripherals/*/tests/host/imu_tests
peripherals/*/tests/host/can_probe_tests
peripherals/*/tests/host/bridge_tests
# dashcam_v0_4 records here when the footage mount is unusable.
footage_fallback/
