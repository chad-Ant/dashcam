bin/build*
logs/*
archive/*
# Recorded videos land in the archive dir (/user/dashcam == repo root under the dev
# mount), so keep stray recordings out of git.
*.mkv
# ...except the 32 KB recorder-made test segment the Android Matroska reader is tested against.
!/android/app/src/test/resources/recorder_fixture.mkv
models/*
docs/*
testlogs/*

# Host test binaries. The sources are the deliverable; these are rebuilt by
# the tests/host Makefiles (or mkr_zero's RunTests.cmd) on every run.
peripherals/*/tests/host/*.exe
peripherals/*/tests/host/*.obj
peripherals/*/tests/host/switch_tests
peripherals/*/tests/host/imu_tests
peripherals/*/tests/host/can_probe_tests
peripherals/*/tests/host/bno_init_tests
peripherals/*/tests/host/bridge_tests
# Python bytecode (running src/tests/test_dashcam_ctl.py or the host checks).
__pycache__/
*.pyc
/.connector-venv/
/android/.gradle/
/android/.kotlin/
/android/local.properties
/android/**/build/
/connector/.state/
# dashcam_v0_4 records here when the footage mount is unusable.
footage_fallback/
# Generated by peripherals/mkr_zero/helper_scripts/CanMapInstall/install_map.sh.
peripherals/mkr_zero/helper_scripts/CanMapInstall/canmap_text.h
/android/app/google-services.json
/connector/cloud/*.so
/connector/cloud/*-debug.log
/connector/cloud/.firebase/
# adb log dumps captured while debugging the Android app on a phone.
/android/*.txt
