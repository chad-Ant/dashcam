[Unit]
Description=Read-only Dashcam Android connector
After=network.target

[Service]
Type=simple
User=jetson
Group=jetson
RuntimeDirectory=dashcam-monitor
RuntimeDirectoryMode=0700
# Keep /run/dashcam-monitor across agent restarts: the recorder container's bind mount
# would otherwise keep pointing at the deleted directory (telemetry and video go silent).
RuntimeDirectoryPreserve=yes
UMask=0077
WorkingDirectory=/home/jetson/dashcam/connector
EnvironmentFile=/home/jetson/.config/dashcam-monitor/service.env
ExecStart=/home/jetson/.local/share/dashcam-monitor/venv/bin/python /home/jetson/dashcam/connector/service.py serve --state-dir /home/jetson/.config/dashcam-monitor --storage ${FOOTAGE_PATH} --advertise-address ${LAN_ADDRESS}
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
