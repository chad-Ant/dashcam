[Unit]
Description=Read-only Dashcam Android connector
After=network.target

[Service]
Type=simple
User=jetson
Group=jetson
RuntimeDirectory=dashcam-monitor
RuntimeDirectoryMode=0700
# Keep /run/dashcam-monitor across agent restarts: the recorder container's bind mount
# would otherwise keep pointing at the deleted directory (telemetry and video go silent).
RuntimeDirectoryPreserve=yes
UMask=0077
WorkingDirectory=/home/jetson/dashcam/connector
EnvironmentFile=/home/jetson/.config/dashcam-monitor/service.env
ExecStart=/home/jetson/.local/share/dashcam-monitor/venv/bin/python /home/jetson/dashcam/connector/service.py serve --state-dir /home/jetson/.config/dashcam-monitor --storage ${FOOTAGE_PATH} --advertise-address ${LAN_ADDRESS}
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Network scope: the agent binds 0.0.0.0, so limit peers here instead of relying on
# a host firewall (ufw is not enabled on the rig). Edit the LAN to match yours.
# 224.0.0.251 keeps mDNS working. Other interfaces (USB device-mode network
# 192.168.55.0/24, docker0, a later Wi-Fi) cannot reach the agent.
IPAddressDeny=any
IPAddressAllow=localhost 192.168.0.0/24 224.0.0.251
# The agent needs none of jetson's supplementary groups: hide the sockets that
# would turn a compromise into root (docker) or system control (jtop), and the
# CA private key, which only the manual "cert" command uses.
InaccessiblePaths=-/run/docker.sock -/run/jtop.sock
InaccessiblePaths=-/home/jetson/.config/dashcam-monitor/ca-key.pem
PrivateDevices=yes

[Install]
WantedBy=multi-user.target
